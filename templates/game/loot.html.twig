<h1>Victoire ! Choisis ta récompense :</h1>

<div class="loot-container" style="display: flex; gap: 20px;">
    {% for item in choices %}
        <div class="card">
            <img src="{{ asset('images/items/' ~ item.imagePath) }}" alt="{{ item.name }}">
            <h3>{{ item.name }}</h3>
            <p>{{ item.description }}</p>
            
            <form action="{{ path('app_arena_loot_select', {id: item.id}) }}" method="POST">
                <button type="submit">Prendre cet objet</button>
            </form>
        </div>
    {% endfor %}
</div>