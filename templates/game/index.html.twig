{# ECRAN PRINCIPAL CHOIX DES PERSONNAGES ETC #}

{% extends 'base.html.twig' %}

{% block title %}Accueil du Jeu
{% endblock %}

{% block body %}
    <div>
        <h1>Bienvenue, {{ app.user.userIdentifier }}!</h1> 
        {% if is_granted('ROLE_ADMIN') %}
            <div>
                <a href="{{ path('admin') }}">Accéder au Back Office</a>
            </div>
        {% endif %}

        <form action="{{ path('app_logout') }}" method="POST">
            <button type="submit">Se déconnecter</button>
        </form>
        
        {% if activeHero %}    {# si le joueur a une partie en cours #}        
            <h2>Partie en cours : {{ activeHero.name | capitalize }} (Niveau {{ activeHero.level }})</h2>

                <form action="{{path('app_arena') }}"method="GET">  {# symfony donne une erreur si POST #}
                    {# aucun CRUD donc il faut obligatoirement GET #}
                    <button type="submit">Continuer la partie</button>
                </form> 

                <form action="{{ path('app_game_restart') }}" method="POST"> {# symfony donne une erreur si GET #}
                    {# CRUD ici dont il faut POST#}
                    <button type="submit">Recommencer (Écraser la sauvegarde)</button>
                </form>
        {% else %}

            {# si aucune partie en cours #}
            <h2>Aucune partie en cours. Choisissez votre héros :</h2>

            <div>
                <form action="{{ path('app_game_create', {'type': 'goku'}) }}" method="POST">
                    <button type="submit">Choisir Goku</button>
                </form>

                <form action="{{ path('app_game_create', {'type': 'piccolo'}) }}" method="POST">
                    <button type="submit">Choisir Piccolo</button>
                </form>

                <form action="{{ path('app_game_create', {'type': 'yamcha'}) }}" method="POST" >
                    <button type="submit">Choisir Yamcha</button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}